{
  "name": "Documentation Publisher – Codespaces",
  "features": {
    "ghcr.io/devcontainers/features/java:1.8.3": {
      "version": "25",
      "additionalVersions": "21",
      "jdkDistro": "tem",
      "installMaven": true,
      "mavenVersion": "3.10.0"
    },
    "ghcr.io/devcontainers/features/git-lfs:1.2.5": {
      "version": "3.8.1",
      "autoPull": false
    }
  },
  "containerEnv": {
    "MAVEN_ARGS": "-B -nsu -Daether.connector.http.connectionMaxTtl=25 -Daether.connector.http.retryHandler.count=5 -Daether.connector.http.retryHandler.serviceUnavailable=429,502,503,504",
    "PIP_DISABLE_PIP_VERSION_CHECK": "1",
    "PYTHONUNBUFFERED": "1"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/ensure-python-environment.sh --quiet && bash .devcontainer/verify-environment.sh --quiet",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "redhat.vscode-yaml",
        "vscjava.vscode-java-pack"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.terminal.activateEnvironment": true,
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.eol": "\n",
        "terminal.integrated.cwd": "${workspaceFolder}"
      }
    }
  },
  "remoteUser": "vscode",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "options": [
      "--platform=linux/amd64"
    ]
  },
  "waitFor": "postCreateCommand"
}
