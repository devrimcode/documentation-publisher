+  cleanup_retries: 2
+  cleanup_delay_seconds: 0.2
+  keep_failed_workspace: false
+  keep_on_success: false
+  lock_timeout_seconds: 60
+
+# Identity N+3: where validated static output is delivered.
+publishing_targets:
+  - id: ci-artifact
+    adapter: artifact
+    output_path: _site-smoke
+publishing:
+  target_id: ci-artifact
